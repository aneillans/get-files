# Example multi-file configuration
DEFAULT_TIMEOUT_SECONDS=60

FILE_1_URL=https://example.com/public.txt
FILE_1_DEST=/downloads/public.txt
FILE_1_AUTH_TYPE=none

FILE_2_URL=https://api.example.com/protected.json
FILE_2_DEST=/downloads/protected/protected.json
FILE_2_AUTH_TYPE=bearer
FILE_2_AUTH_TOKEN=replace-me

FILE_3_URL=https://files.example.com/archive.zip
FILE_3_DEST=/downloads/archives/archive.zip
FILE_3_AUTH_TYPE=basic
FILE_3_AUTH_USERNAME=replace-user
FILE_3_AUTH_PASSWORD=replace-pass

FILE_4_URL=https://gateway.example.com/export
FILE_4_DEST=/downloads/export.json
FILE_4_AUTH_TYPE=header
FILE_4_AUTH_HEADER_NAME=X-API-Key
FILE_4_AUTH_HEADER_VALUE=replace-key
FILE_4_HEADERS_JSON={"Accept":"application/json"}
